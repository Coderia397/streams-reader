   "args": [
    3
   ]
  },
  {
   "do": "play"
  },
  {
   "settle": true
  },
  {
   "wait": 300
  },
  {
   "do": "seek_by",
   "args": [
    15000
   ]
  },
  {
   "settle": true
  },
  {
   "do": "set_sleep",
   "args": [
    4000,
    false
   ]
  },
  {
   "wait": 6000
  },
  {
   "assert": {
    "state": "Paused",
    "segment": 4,
    "check": "fb_sleep"
   }
  }
 ]
}