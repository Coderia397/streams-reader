{
 "name": "140-r4fb-countdown-across-switch",
 "description": "fallback: a 4 s countdown set 1.5 s before the end of 3 fires once in 4, paused.",
 "config": {
  "query": "nomse=1",
  "delay_ms": 0
 },
 "expect_events": {
  "SleepFired": 1
 },
 "steps": [
