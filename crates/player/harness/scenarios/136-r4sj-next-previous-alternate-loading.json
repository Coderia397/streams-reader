   "args": [
    10
   ]
  },
  {
   "do": "play"
  },
  {
   "do": "next",
   "gap": 60
  },
  {
   "do": "previous",
   "gap": 60
  },
  {
   "do": "next",
   "gap": 60
  },
  {
   "do": "previous",
   "gap": 60
  },
  {
   "do": "next"
  },
  {
   "settle": true,
   "timeout": 15000
  },
  {
   "observe": 1500
  }
 ]
}
