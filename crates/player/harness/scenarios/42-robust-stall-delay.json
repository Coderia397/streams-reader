{
 "name": "42-robust-stall-delay",
 "description": "Robustness: segment 4 takes 7 s to render while 3 plays; the playhead reaches the end of 3 and buffers, a pause during the stall holds when 4 arrives, play resumes at 4.",
 "config": {"delay_ms": 0, "delays": {"4": 7000}},
 "steps": [
  {"do": "load", "args": [3]}, {"do": "play"}, {"settle": true}, {"wait": 300},
  {"do": "seek_by", "args": [15500]}, {"settle": true}, {"observe": 1200},
  {"wait": 1500},
  {"assert": {"state": "Buffering", "segment": 3, "check": "stall"}},
  {"do": "pause"}, {"wait": 6000},
  {"assert": {"state": "Paused", "check": "stall"}},
  {"do": "play"}, {"wait": 1500},
  {"assert": {"state": "Playing", "segment": 4, "check": "stall"}},
  {"observe": 1500}
 ]
}
