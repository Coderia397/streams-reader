   "args": [
    3
   ]
  },
  {
   "do": "play"
  },
  {
   "settle": true
  },
  {
   "wait": 300
  },
  {
   "do": "seek_by",
   "args": [
    18000
   ],
   "expect": false
  },
  {
   "do": "seek_by",
   "args": [
    -18000
   ],
   "expect": false
  },
  {
   "wait": 1500
  },
  {
   "assert": {
    "state": "Playing",
    "segment": 3,
    "check": "hold_back"
   }
  },
  {
