 "config": {
  "delay_ms": 0,
  "delays": {
   "5": 4000
  }
 },
 "steps": [
  {
   "do": "load",
   "args": [
    4
   ]
  },
  {
   "do": "play"
  },
  {
   "settle": true,
   "timeout": 10000
  },
  {
   "wait": 600
  },
  {
   "do": "seek_by",
   "args": [
    5000
   ],
   "gap": 40
  },
  {
   "do": "seek_by",
   "args": [
    5000
   ],
   "gap": 40
  },
  {
   "do": "seek_by",
   "args": [
    -5000
   ],
   "gap": 40
  },
  {
   "do": "seek_by",
   "args": [
    5000
   ]
  },
  {
   "settle": true,
   "timeout": 12000
  },
  {
   "observe": 2000
  }
 ]
}
