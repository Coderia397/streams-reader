{
 "name": "152-r4rob-countdown-across-hold",
 "description": "2.5 s countdown, then a skip into 4 whose fetch takes 3 s: the countdown waits through Loading and fires once about 2.5 s of playing later, in 4.",
 "config": {
  "delay_ms": 0,
  "delays": {
   "4": 3000
  }
 },
 "expect_events": {
  "SleepFired": 1
 },
 "steps": [
  {
   "do": "load",
   "args": [
    3
   ]
  },
  {
   "do": "play"
  },
  {
   "settle": true
  },
  {
   "wait": 200
  },
  {
   "do": "set_sleep",
   "args": [
    2500,
    false
   ]
  },
  {
   "wait": 500
  },
  {
   "do": "seek_by",
   "args": [
    18000
   ]
  },
  {
   "wait": 1500
  },
  {
   "assert": {
    "state": "Loading",
    "check": "sleep_hold"
   }
  },
  {
   "settle": true
  },
  {
   "wait": 3500
  },
  {
   "assert": {
    "state": "Paused",
    "segment": 4,
    "check": "sleep_hold"
   }
  }
 ]
}