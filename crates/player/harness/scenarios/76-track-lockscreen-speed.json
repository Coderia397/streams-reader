{
 "name": "76-track-lockscreen-speed",
 "description": "Lock-screen position at 2x after a start, an in-buffer skip, a pause/resume and a rebuild jump: the extrapolated position must stay on the clock.",
 "config": {"delay_ms": 0},
 "steps": [
  {"do": "set_rate", "args": [2.0]},
  {"do": "load", "args": [8]}, {"do": "play"}, {"settle": true}, {"observe": 3000},
  {"do": "seek_by", "args": [5000]}, {"settle": true}, {"observe": 2000},
  {"do": "pause"}, {"wait": 500}, {"do": "play"}, {"wait": 200}, {"observe": 2000},
  {"do": "jump_to", "args": [20]}, {"settle": true}, {"observe": 2500},
  {"do": "set_rate", "args": [1.0]}
 ]
}
