{
 "name": "162-r4rob-countdown-fade-rebuild",
 "description": "12 s countdown; inside the fade a jump to 20 rebuilds; the countdown resumes after placement and fires once.",
 "config": {
  "delay_ms": 0
 },
 "expect_events": {
  "SleepFired": 1
 },
 "steps": [
  {
   "do": "load",
   "args": [
    3
   ]
  },
  {
   "do": "play"
  },
  {
   "settle": true
  },
  {
   "do": "set_sleep",
   "args": [
    12000,
    false
   ]
  },
  {
   "wait": 5000
  },
  {
   "do": "jump_to",
   "args": [
    20
   ]
  },
  {
   "settle": true
  },
  {
   "observe": 2000
  },
  {
   "wait": 6500
  },
  {
   "assert": {
    "state": "Paused",
    "segment": 20,
    "check": "fade_rebuild"
   }
  }
 ]
}