{
 "name": "11-sleep-end-of-section",
 "description": "Sleep at end of section: segment 15 closes a section; playback pauses in its closing silence and parks at segment 16.",
 "config": {"delay_ms": 0},
 "expect_events": {"SleepFired": 1, "Ended": 0},
 "steps": [
  {"do": "load", "args": [15]}, {"do": "play"}, {"settle": true},
  {"do": "set_sleep", "args": [0, true]},
  {"do": "seek_by", "args": [15000]}, {"settle": true},
  {"until": "SleepFired", "timeout": 6000}, {"wait": 600},
  {"assert": {"state": "Paused", "segment": 16, "max_pos_ms": 300}}
 ]
}
