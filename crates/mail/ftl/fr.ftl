# E-mails de connexion, français.

greeting = Bonjour,
code-label = Votre code
code-or-link = Ou utilisez le bouton sur cet appareil.
button-fallback = Si le bouton ne fonctionne pas, copiez cette adresse dans votre navigateur :
ignore = Si vous n'êtes pas à l'origine de cette demande, ignorez cet e-mail. Personne ne peut se connecter sans le code.
footer = Envoyé par { $brand } · { $site }

signup-subject = { $code } est votre code { $brand }
signup-title = Terminez la création de votre compte
signup-body = Bienvenue sur { $brand }. Saisissez ce code dans l'application pour terminer la création de votre compte. Il ne fonctionne qu'une fois et expire dans { $minutes } minutes.
signup-button = Confirmer et se connecter

magiclink-subject = { $code } est votre code de connexion { $brand }
magiclink-title = Votre code de connexion
magiclink-body = Saisissez ce code pour vous connecter. Il ne fonctionne qu'une fois et expire dans { $minutes } minutes.
magiclink-button = Se connecter

recovery-subject = Retrouvez l'accès à votre compte { $brand }
recovery-title = Retrouvez l'accès à votre compte
recovery-body = Saisissez ce code ou utilisez le bouton pour vous reconnecter. Il ne fonctionne qu'une fois et expire dans { $minutes } minutes.
recovery-button = Se connecter

email-change-subject = Confirmez votre nouvelle adresse e-mail { $brand }
email-change-title = Confirmez le changement d'adresse
email-change-body = Vous avez demandé à remplacer l'adresse e-mail de votre compte { $brand } par { $new_email }. Saisissez ce code ou utilisez le bouton pour confirmer.
email-change-button = Confirmer le changement

invite-subject = Vous êtes invité à rejoindre { $brand }
invite-title = Vous êtes invité
invite-body = Quelqu'un vous invite sur { $brand }, une application qui lit vos articles et vos livres à voix haute. Acceptez l'invitation pour créer votre compte.
invite-button = Accepter l'invitation

reauthentication-subject = { $code } est votre code de confirmation { $brand }
reauthentication-title = Confirmez votre identité
reauthentication-body = Saisissez ce code pour confirmer que c'est bien vous. Il ne fonctionne qu'une fois et expire dans { $minutes } minutes.
