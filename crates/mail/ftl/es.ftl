# Correos de acceso, español.

greeting = Hola:
code-label = Tu código
code-or-link = O usa el botón en este dispositivo.
button-fallback = Si el botón no funciona, copia esta dirección en tu navegador:
ignore = Si no lo pediste, puedes ignorar este correo. Nadie puede entrar sin el código.
footer = Enviado por { $brand } · { $site }

signup-subject = { $code } es tu código de { $brand }
signup-title = Termina de crear tu cuenta
signup-body = Te damos la bienvenida a { $brand }. Introduce este código en la app para terminar de crear tu cuenta. Funciona una sola vez y caduca en { $minutes } minutos.
signup-button = Confirmar e iniciar sesión

magiclink-subject = { $code } es tu código para entrar en { $brand }
magiclink-title = Tu código de acceso
magiclink-body = Introduce este código para iniciar sesión. Funciona una sola vez y caduca en { $minutes } minutos.
magiclink-button = Iniciar sesión

recovery-subject = Vuelve a entrar en tu cuenta de { $brand }
recovery-title = Vuelve a entrar en tu cuenta
recovery-body = Introduce este código o usa el botón para volver a iniciar sesión. Funciona una sola vez y caduca en { $minutes } minutos.
recovery-button = Iniciar sesión

email-change-subject = Confirma tu nuevo correo de { $brand }
email-change-title = Confirma el cambio de correo
email-change-body = Pediste cambiar el correo de tu cuenta de { $brand } a { $new_email }. Introduce este código o usa el botón para confirmarlo.
email-change-button = Confirmar el cambio

invite-subject = Te han invitado a { $brand }
invite-title = Te han invitado
invite-body = Alguien te ha invitado a { $brand }, una app que lee en voz alta tus artículos y libros. Acepta la invitación para crear tu cuenta.
invite-button = Aceptar la invitación

reauthentication-subject = { $code } es tu código de confirmación de { $brand }
reauthentication-title = Confirma que eres tú
reauthentication-body = Introduce este código para confirmar que eres tú. Funciona una sola vez y caduca en { $minutes } minutos.
