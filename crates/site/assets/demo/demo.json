  {
   "id": "story",
   "text": "It is a truth universally acknowledged, that a single man in possession of a good fortune, must be in want of a wife.",
   "source": "Jane Austen, Pride and Prejudice (1813)",
   "clips": [
    "af_heart",
    "am_michael",
    "bf_isabella",
    "bm_george"
   ]
  },
  {
   "id": "article",
   "text": "Why is the sky blue? Sunlight holds every colour, but the air scatters short blue waves far more than long red ones. So blue light reaches your eyes from every direction you look.",
   "source": "Streams Reader",
   "clips": [
    "af_heart",
    "am_michael",
    "bf_isabella",
    "bm_george"
   ]
  },
  {
   "id": "poem",
   "text": "Hope is the thing with feathers,\nThat perches in the soul,\nAnd sings the tune without the words,\nAnd never stops at all.",
   "source": "Emily Dickinson (1891)",
   "clips": [
    "af_heart",
    "am_michael",
    "bf_isabella",
    "bm_george"
   ]
  },
  {
   "id": "night",
   "text": "It's late. Your eyes are tired, but the story isn't finished. So let it read to you.",
   "source": "Streams Reader",
   "clips": [
