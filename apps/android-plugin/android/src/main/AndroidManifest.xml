<?xml version="1.0" encoding="utf-8"?>
<!--
  Merged into the app manifest (apps/tauri/src-tauri/gen/android) by the Android manifest merger.
  Sources for each entry: notes/18-native-apps-architecture.md, "Android layer".
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background playback: Media3 MediaSessionService runs as a foreground service of type mediaPlayback. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- API 33+: the media notification is shown in the media controls even if denied; asked once on first play. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Self-update through PackageInstaller. The user allows "Install unknown apps" for this app once; after that a
         self-update with USER_ACTION_NOT_REQUIRED needs no prompt (API 31+, targetSdk >= 35 on Android 17). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application>
        <service
            android:name="watch.streams.reader.media.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Result of a PackageInstaller session (self-update). -->
        <receiver
            android:name="watch.streams.reader.media.InstallResultReceiver"
            android:exported="false" />

        <!--
          Share target and "open with": merged into Tauri's generated activity (same android:name). Assumed to merge;
          if the generated manifest already declares conflicting filters, move these into gen/android by hand.
        -->
        <activity android:name="watch.streams.reader.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- nolabs://auth/... is declared by tauri-plugin-deep-link (plugins.deep-link.mobile in tauri.conf.json),
                 which writes its own intent filter into the generated manifest. -->
        </activity>
    </application>
</manifest>
